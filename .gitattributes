# Only immutable multipart escrow payloads are stored through Git LFS.
02_Tools/archives/build-environment/*.part[0-9][0-9][0-9] filter=lfs diff=lfs merge=lfs -text
02_Tools/archives/wsl-host-bootstrap/*.part[0-9][0-9][0-9] filter=lfs diff=lfs merge=lfs -text

# Linux entry points and build definitions must survive Windows checkouts.
*.sh text eol=lf
02_Tools/containers/**/Containerfile text eol=lf
