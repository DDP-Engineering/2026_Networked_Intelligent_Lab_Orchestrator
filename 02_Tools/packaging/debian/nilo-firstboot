#!/bin/sh
# Hand one root-only first-boot secret to the unprivileged identity command.
set -eu

source=/var/lib/nilo-installer/first-admin.password
handoff=/run/nilo/first-admin.password
[ "$(id -u)" -eq 0 ] || { echo 'first-boot seeding requires root' >&2; exit 1; }
[ -f "$source" ] && [ ! -L "$source" ] || exit 0
[ "$(stat -c '%a:%U:%G' "$source")" = '600:root:root' ] || {
  echo 'first administrator source must be mode 0600 and owned by root' >&2
  exit 1
}
install -d -o nilo -g nilo -m 0750 /run/nilo
install -o nilo -g nilo -m 0600 "$source" "$handoff"
trap 'rm -f -- "$handoff"' EXIT HUP INT TERM
runuser -u nilo -- /usr/bin/nilo seed-admin \
  --data-dir /var/lib/nilo \
  --username "${NILO_FIRST_ADMIN_USERNAME:-admin}" \
  --password-file "$handoff"
[ ! -e "$handoff" ] || { echo 'administrator handoff was not consumed' >&2; exit 1; }
rm -f -- "$source"
sync /var/lib/nilo-installer /run/nilo
trap - EXIT HUP INT TERM
