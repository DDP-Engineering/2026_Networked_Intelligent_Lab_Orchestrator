[Unit]
Description=Seed the first NILO administrator from a protected file
Before=nilo.service
ConditionPathExists=/var/lib/nilo-installer/first-admin.password

[Service]
Type=oneshot
EnvironmentFile=-/etc/nilo/firstboot.env
ExecStart=/usr/libexec/nilo/nilo-firstboot
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nilo /var/lib/nilo-installer /run/nilo

[Install]
WantedBy=multi-user.target
