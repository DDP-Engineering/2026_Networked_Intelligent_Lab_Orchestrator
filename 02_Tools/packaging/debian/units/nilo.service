[Unit]
Description=NILO Bench Core
After=network-online.target nilo-image-firstboot.service nilo-nethelper.socket nilo-nethelper.service nilo-firstboot.service
Wants=network-online.target
Requires=nilo-image-firstboot.service nilo-nethelper.socket nilo-nethelper.service

[Service]
Type=simple
User=nilo
Group=nilo
SupplementaryGroups=video
EnvironmentFile=-/etc/nilo/nilo.env
ExecStart=/usr/bin/nilo serve --profile appliance --data-dir /var/lib/nilo --gui-dir /usr/share/nilo/gui --integration-bundles /usr/lib/nilo/integration-bundles --local-status-bind 127.0.0.1:8091
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nilo /var/log/nilo /run/nilo
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
