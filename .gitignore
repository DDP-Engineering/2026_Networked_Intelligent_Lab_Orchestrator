# Downloaded repository-local runtime tools are reproducible from 02_Tools.
/02_Tools/runtime/
/02_Tools/cache/

# Generated Python environments and bytecode are never source artifacts.
**/.venv/
**/.venv-*/
__pycache__/
**/__pycache__/
*.py[cod]

# Generated frontend dependencies, test coverage, and static build output.
**/node_modules/
**/coverage/
**/dist/

# Generated browser end-to-end run output. A successful run leaves none.
**/test-results/
**/playwright-report/

# Local frontend environment overrides are per-developer, never shared.
**/.env.local
**/.env.*.local

# WireGuard peer configurations carry a private key and a preshared key, which
# are real credentials for a network outside this bench. Unlike the bench device
# password in 06_SoftwareDocu/Local_Hardware_Access.md, these are not disposable
# and must never enter the history of a repository that gets cloned.
*.conf.wg
**/wg*.conf
/DDP_Ubuntu.conf
