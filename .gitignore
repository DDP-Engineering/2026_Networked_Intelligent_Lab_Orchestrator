# Downloaded repository-local runtime tools are reproducible from 02_Tools.
/02_Tools/runtime/
/02_Tools/cache/

# Generated Python environments and bytecode are never source artifacts.
**/.venv/
**/.venv-*/
__pycache__/
**/__pycache__/
*.py[cod]

# Generated frontend dependencies, test coverage, and static build output.
**/node_modules/
**/coverage/
**/dist/
