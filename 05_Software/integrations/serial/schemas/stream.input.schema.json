{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "endpoint_id",
    "hardware_identity",
    "workspace_directory",
    "settings"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^serial-[1-9][0-9]*$"
    },
    "endpoint_id": {
      "type": "string",
      "pattern": "^tty(USB|ACM)[0-9]+$"
    },
    "hardware_identity": {
      "type": "object"
    },
    "workspace_directory": {
      "type": "string"
    },
    "settings": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baud_rate": {
          "type": "integer",
          "minimum": 50,
          "maximum": 4000000
        },
        "data_bits": {
          "enum": [
            5,
            6,
            7,
            8
          ]
        },
        "parity": {
          "enum": [
            "none",
            "odd",
            "even",
            "mark",
            "space"
          ]
        },
        "stop_bits": {
          "enum": [
            1,
            1.5,
            2
          ]
        },
        "flow_control": {
          "enum": [
            "none",
            "rtscts",
            "xonxoff"
          ]
        },
        "rts": {
          "type": "boolean"
        },
        "dtr": {
          "type": "boolean"
        }
      }
    }
  }
}
