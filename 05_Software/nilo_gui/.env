# Default NILO GUI configuration: a Windows browser talking to Bench Core
# running under WSL2 on the loopback development endpoint.
#
# These values are build-time only and contain no credential. Override them
# locally in an ignored .env.local file rather than editing this one.

# live = call a real Bench Core backend; mock = use the built-in contract mock.
VITE_NILO_API_MODE=live

# Must match the --bind address passed to `nilo serve --profile simulation`.
VITE_NILO_API_BASE_URL=http://127.0.0.1:8090
