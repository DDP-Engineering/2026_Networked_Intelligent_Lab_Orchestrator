{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "protocol", "platforms", "runner", "app_configuration_schema", "operations", "cancellation", "events", "artifacts", "health_checks", "contract_fixtures"],
  "properties": {
    "package": {"type": "object", "additionalProperties": false, "required": ["id", "version", "publisher", "integrity"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "version": {"type": "string", "minLength": 1}, "publisher": {"type": "string", "minLength": 1}, "integrity": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}}},
    "protocol": {"type": "string", "minLength": 1},
    "platforms": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["os", "architecture"], "properties": {"os": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}}}},
    "runner": {"type": "object", "additionalProperties": false, "required": ["executable", "arguments"], "properties": {"executable": {"type": "string", "minLength": 1}, "arguments": {"type": "array", "items": {"type": "string"}}, "platform_overrides": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["os", "architecture", "executable", "arguments"], "properties": {"os": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "executable": {"type": "string", "minLength": 1}, "arguments": {"type": "array", "items": {"type": "string"}}}}}}},
    "app_configuration_schema": {"type": "string", "minLength": 1},
    "operations": {"type": "array", "items": {"$ref": "operation.schema.json"}},
    "cancellation": {"type": "object", "additionalProperties": false, "required": ["supported", "safe_shutdown"], "properties": {"supported": {"type": "boolean"}, "safe_shutdown": {"type": "string"}}},
    "events": {"type": "array", "items": {"$ref": "event.schema.json"}},
    "artifacts": {"type": "array", "items": {"$ref": "event.schema.json"}},
    "health_checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "timeout"], "properties": {"id": {"type": "string", "minLength": 1}, "timeout": {"type": "string", "minLength": 1, "maxLength": 32}}}},
    "contract_fixtures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "state_schema": {"type": "integer", "minimum": 1},
    "state_migrations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "kind"], "properties": {"from": {"type": "integer", "minimum": 1}, "to": {"type": "integer", "minimum": 2}, "kind": {"const": "preserve-json"}}}}
  }
}
