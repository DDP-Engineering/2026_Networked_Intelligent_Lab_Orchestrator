# Isolated frontend development: no WSL2 backend, no network request.
# Selected by `npm run dev:mock` and `npm run build:mock`, which pass
# `--mode mock` to Vite.

VITE_NILO_API_MODE=mock

# Which answer the mock gives, per resource:
#
#   healthy                 status healthy, ready integration and device inventory
#   unavailable-inventory   backend answers, inventory reports itself unavailable
#   empty                   backend answers, both inventories are valid and empty
#   unauthorized            every resource rejects the token
#   unavailable             nothing answers at all
#   malformed-status        status outside the contract, inventories fine
#   malformed-integrations  integration inventory outside the contract, rest fine
#   malformed-devices       device inventory outside the contract, rest fine
#
# `malformed` is still accepted and means `malformed-status`.
VITE_NILO_MOCK_SCENARIO=healthy

# Shown on the login screen so the endpoint the live build would call stays
# visible; nothing is sent to it in mock mode.
VITE_NILO_API_BASE_URL=http://127.0.0.1:8090
